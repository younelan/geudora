/**********************************************************************
 * GetAMessage - grab a message
 **********************************************************************/
MyWindowPtr GetAMessageLo(TOCHandle origTocH, int origSumNum, GtkWidget *winWP,
                          MyWindowPtr win, bool showIt, bool *newWin) {
    GtkWidget *messWinWP;
    MessHandle messH;
    TOCHandle tocH;
    short sumNum;

    if (newWin)
        *newWin = true;
    tocH = GetRealTOC(origTocH, origSumNum, &sumNum);
    if (!tocH || (*tocH)->count <= sumNum)
        return (NULL);
    if ((messH = (*tocH)->sums[sumNum].messH)) {
        messWinWP = (GtkWidget *)GetMyWindowWindowPtr((*messH)->win);
        if (newWin)
            *newWin = false;
        if (showIt) {
            if (!gtk_widget_get_visible(messWinWP))
                gtk_widget_set_visible(messWinWP, TRUE);
            gtk_window_present(GTK_WINDOW(messWinWP));
        }
        win = (*messH)->win;
    } else if ((*tocH)->which == OUT)
        win = OpenComp(tocH, sumNum, winWP, win, showIt, false);
#ifdef NEVER
    else if (IsALink(tocH, sumNum))
        win = OpenLink(tocH, sumNum, winWP, win, showIt);
#endif
    else
#ifdef IMAP
        win = OpenMessage(tocH, sumNum, winWP, win, showIt, false);
#else
        win = OpenMessage(tocH, sumNum, winWP, win, showIt);
#endif
    if (win) {
        (*Win2MessH(win))->openedFromTocH = origTocH;
        (*Win2MessH(win))->openedFromSerialNum =
            (*origTocH)->sums[origSumNum].serialNum;
    }
    return (win);
}

/**********************************************************************
 * OpenMessage - open a message in its own window
 **********************************************************************/
#ifdef IMAP
MyWindowPtr OpenMessage(TOCHandle tocH, short sumNum, GtkWidget *winWP,
                        MyWindowPtr win, bool showIt, bool preview)
#else
MyWindowPtr OpenMessage(TOCHandle tocH, short sumNum, GtkWidget *winWP,
                        MyWindowPtr win, bool showIt)
#endif
{
    MessHandle messH;
    bool turvy = showIt;
    char *text = NULL;
    short ezOpenSum;
    geditDocument *pdi; // Replace PETEDocInitInfo with geditDocument
    int err;
    long size;
    long partial = GetRLong(PETE_NIBBLE) * 1024;
    GtkWidget *TheBody;
    GList *stack = NULL; // Use GList instead of StackHandle
    bool useLizzie = false, disableButtons = false;

    if (!(tocH = GetRealTOC(tocH, sumNum, &sumNum)))
        return NULL;

    if ((messH = (MessHandle)g_malloc0(sizeof(MessType))) == NULL)
        return (NULL);

    if (!win) {
        win = (MyWindowPtr)g_malloc0(sizeof(MyWindow));
        if (!win)
            return NULL;
        win->window = gtk_window_new();
        win->pte = NULL;
    }
    if (!win) {
        g_free(messH);
        return (NULL);
    }

    winWP = (GtkWidget *)GetMyWindowWindowPtr(win);

    (*tocH)->sums[sumNum].messH = messH;
    (*messH)->win = win;
    (*messH)->sumNum = sumNum;
    (*messH)->tocH = tocH;
    
    /* apply FLAG_OUT ex post facto */
    if ((*tocH)->sums[sumNum].state == SENT ||
        (*tocH)->sums[sumNum].state == UNSENT)
        (*tocH)->sums[sumNum].flags |= FLAG_OUT;

    SetMyWindowPrivateData(win, (void *)messH);

    if (MessOptIsSet(messH, OPT_WRITE))
        ClearMessOpt(messH, OPT_WRITE);

#ifdef IMAP
    // Actually go fetch this message if we must
    if ((*tocH)->imapTOC && !IMAPMessageDownloaded(tocH, sumNum)) {
        // threading is off.  Download message now
        if (PrefIsSet(PREF_THREADING_OFF) || !ThreadsAvailable()) {
            if (EnsureMsgDownloaded(tocH, sumNum, true))
                text = GetMessText(messH);
        } else {
            char scratch[256];
            bool reallyGetIt = !preview || (!Offline && AutoCheckOK());

            err = 0;
            if (!IMAPMessageBeingDownloaded(tocH, sumNum) &&
                !IMAPMessageDownloaded(tocH, sumNum) && reallyGetIt)
                err = UIDDownloadMessage(tocH, (*tocH)->sums[sumNum].uidHash, false, false);
            if (err)
                goto Abort;

            if (!reallyGetIt)
                GetRString(scratch, IMAP_GETTING_MESSAGE_OFFLINE);
            else
                GetRString(scratch, IMAP_GETTING_MESSAGE);
            text = g_strdup(scratch);
            disableButtons = true;
        }
    } else
#endif
        text = GetMessText(messH);
    useLizzie = false;

    // Create gEditCtrl widget instead of Pete
    win->pte = geditctrl_new();
    if (!win->pte || !text)
        goto Abort;
    TheBody = win->pte;
    
    if (MessFlagIsSet(messH, FLAG_FIXED_WIDTH)) {
        // Set fixed width font using modern GTK4 CSS
        GtkCssProvider *provider = gtk_css_provider_new();
        gtk_css_provider_load_from_string(provider, "textview { font-family: monospace; font-size: 12pt; }");
        gtk_style_context_add_provider(gtk_widget_get_style_context(TheBody),
                                       GTK_STYLE_PROVIDER(provider),
                                       GTK_STYLE_PROVIDER_PRIORITY_APPLICATION);
        g_object_unref(provider);
    }

    {
        size = strlen(text);
        if (!partial || size < partial) {
            if (!MessFlagIsSet(messH, FLAG_SHOW_ALL) &&
                (MessFlagIsSet(messH, FLAG_RICH)
#ifndef OLDHTML
                 || MessOptIsSet(messH, OPT_HTML)
#endif
                 || MessOptIsSet(messH, OPT_FLOW) ||
                 MessOptIsSet(messH, OPT_CHARSET))) {
                // Insert rich text using gEditCtrl
                geditDocument *doc = geditctrl_get_document(TheBody);
                gedit_document_insert_markup(doc, 0, text);
                g_free(text);
            } else {
                // Insert plain text
                geditDocument *doc = geditctrl_get_document(TheBody);
                gedit_document_insert_text(doc, 0, text);
            }
            text = NULL;
        } else {
            // Insert partial text
            char *partial_text = g_strndup(text, partial);
            geditDocument *doc = geditctrl_get_document(TheBody);
            gedit_document_insert_text(doc, 0, partial_text);
            g_free(partial_text);
        }
    }
    
    if (err) {
        if (err != -128) // userCancelled
            WarnUser(PETE_ERR, err);
    } else {
        /* GTK Title setting */
        {
            char title[256];
            MakeMessTitle(title, tocH, sumNum, false);
            gtk_window_set_title(GTK_WINDOW(winWP), title);
        }

        if (showIt) {
            ezOpenSum = EzOpenFind(tocH, sumNum);
            if (ShowMyWindow(winWP)) {
                return (NULL);
            }

            ShowMessageSeparator(TheBody, true);
            PeteFocus(win, TheBody, true);

            if (text && !useLizzie) {
                // Insert remaining text
                char *remaining_text = text + partial;
                long remaining_size = size - partial;
                if (remaining_size > 0) {
                    char *remaining_str = g_strndup(remaining_text, remaining_size);
                    geditDocument *doc = geditctrl_get_document(TheBody);
                    gedit_document_insert_text(doc, gedit_document_get_length(doc), remaining_str);
                    g_free(remaining_str);
                }
                g_free(text);
                text = NULL;
            }

            if (!err && ezOpenSum >= 0) {
                (*messH)->ezOpenSerialNum = (*tocH)->sums[ezOpenSum].serialNum;
                CacheMessage(tocH, ezOpenSum);
            }
            if (disableButtons)
                EnableMsgButtons(win, false);
        }
    }

    if (err) {
    Abort:
        PeteCleanList(win->pte);
        CloseMyWindow(winWP);
        win = NULL;
        if (text)
            g_free(text);
    }

    return (win);
}
/**********************************************************************
 * MessCurAddr - return the address most closely associated with this message
 **********************************************************************/
char *MessCurAddr(MyWindowPtr win, char *addr) {
    MessHandle messH = Win2MessH(win);
    extern char *CompCurAddr(MyWindowPtr win, char *addr);

    *addr = 0;

    if (messH) {
        if (MessFlagIsSet(messH, FLAG_OUT))
            CompCurAddr(win, addr);
        else {
            SuckHeaderText(messH, addr, 256, FROM_HEAD);
            ShortAddr(addr, addr);
        }
    }

    return *addr ? addr : NULL;
}

/**********************************************************************
 * MakeMessTitle - make a reasonable message title from a summary
 **********************************************************************/
void MakeMessTitle(char *title, TOCHandle tocH, int sumNum, bool useSummary) {
    char from[64], date[64], time[64], mailbox[64], subject[64];
    char pattern[64];
    char datetime[64];
    long secs;
    char zoneStr[32];
    long zone;

    // Use standard C string functions instead of PCopy
    g_strlcpy(from, (*tocH)->sums[sumNum].from, sizeof(from));
    if (useSummary)
        from[MIN(strlen(from), (*BoxWidths)[blFrom - 1])] = '\0';

    if (useSummary) {
        if ((*BoxWidths)[blDate - 1] > 1) {
            ComputeLocalDate((*tocH)->sums + sumNum, datetime);
            datetime[MIN(strlen(datetime), (*BoxWidths)[blDate - 1])] = '\0';
        } else
            datetime[0] = '\0';
    } else {
        if ((secs = (*tocH)->sums[sumNum].seconds)) {
            zone = PrefIsSet(PREF_LOCAL_DATE) ? ZoneSecs()
                                              : 60 * (*tocH)->sums[sumNum].origZone;
            secs += zone;
            FormatZone(zoneStr, zone);
            TimeString(secs, false, time, NULL);
            DateString(secs, longDate, date, NULL);
            utl_PlugParams(GetRString(pattern, DATE_SUM_FMT), datetime, date, time,
                           zoneStr, "");
        } else
            datetime[0] = '\0';
    }

    GetMailboxName(tocH, sumNum, mailbox);
    g_strlcpy(subject, (*tocH)->sums[sumNum].subj, sizeof(subject));

    utl_PlugParams(GetRString(pattern, MESS_TITLE_PLUG), title, mailbox, from,
                   datetime, subject);
}

/**********************************************************************
 * EnsureFromHash - make sure a message has a from id
 **********************************************************************/
int EnsureFromHash(TOCHandle tocH, short sumNum) {
    int err = noErr;
    char scratch[256], shortAddr[256];
    unsigned long addrHash;

    if ((*tocH)->sums[sumNum].fromHash == kNeverHashed) {
        if (!(err = CacheMessage(tocH, sumNum))) {
            // No need for HNoPurge with standard malloc

            strcpy(scratch, HeaderName(FROM_HEAD));
            TrimWhite(scratch);
            // TODO: Fix HandleHeadGetPStr call for proper header parsing
            ShortAddr(shortAddr, scratch);
            MyLowerStr(shortAddr);
            addrHash = Hash(shortAddr);

            // No need for HPurge with standard malloc

            (*tocH)->sums[sumNum].fromHash = addrHash;
            TOCSetDirty(tocH, true);
        }
    }
    return (err);
}

/**********************************************************************
 * CacheMessage - put a message into the cache
 **********************************************************************/
int CacheMessage(TOCHandle tocH, short sumNum) {
    char *cache;
    int err = noErr;

    if (0 > sumNum || sumNum >= (*tocH)->count)
        return (fnfErr);

#ifdef IMAP
    if ((*tocH)->sums[sumNum].offset < 0)
        return (fnfErr);
#endif

    if ((*tocH)->sums[sumNum].cache) {
        if ((*tocH)->sums[sumNum].cache)
            return (noErr);
        else
            g_free((*tocH)->sums[sumNum].cache);
    }

    long messageLength = GetMessageLength(tocH, sumNum);
    if ((cache = g_malloc(messageLength))) {
        err = ReadMessage(tocH, sumNum, (unsigned char *)cache);
        if (err)
            g_free(cache);
        else {
            (*tocH)->sums[sumNum].cache = (void *)cache;
            // Ensure message ends with CR
            if (cache[messageLength - 1] != '\015') {
                cache = g_realloc(cache, messageLength + 1);
                cache[messageLength] = '\015';
                (*tocH)->sums[sumNum].cache = (void *)cache;
            }
        }
    } else
        err = errno;

    return (err);
}

/**********************************************************************
 * GetMessText - put the text of a message
 **********************************************************************/
char *GetMessText(MessHandle messH) {
    MyWindowPtr win = (*messH)->win;
    TOCHandle tocH = (*messH)->tocH;
    int sumNum = (*messH)->sumNum;
    char *buffer = NULL;
    long weeded;
    short tableId;
    char *table = NULL;
    char *cache = NULL;
    Accumulator weeds;

    memset(&weeds, 0, sizeof(weeds));

    if ((*tocH)->sums[sumNum].cache) {
        cache = (char *)(*tocH)->sums[sumNum].cache;
        // No need for HNoPurge in GTK/GLib
    } else {
        g_free((*tocH)->sums[sumNum].cache);
        (*tocH)->sums[sumNum].cache = NULL;
    }

    long messageLength = GetMessageLength(tocH, sumNum);
    if (messageLength > (GetRLong(PETE_NIBBLE) * 1024))
        buffer = g_malloc(messageLength + 1);
    else
        buffer = g_malloc(messageLength + 1);
    
    if (buffer == NULL) {
        if (!cache) {
            WarnUser(NO_MESS_BUF, errno);
            return (NULL);
        }
    }

    if (cache) {
        if (buffer) {
            memcpy(buffer, cache, messageLength);
            buffer[messageLength] = '\0';
            // No need for HPurge in GTK/GLib
        } else {
            buffer = cache;
            cache = NULL;
            (*tocH)->sums[sumNum].cache = NULL;
        }
    } else {
        if ((MessErr = ReadMessage(tocH, sumNum, (unsigned char *)buffer)))
            goto failure;
        buffer[messageLength] = '\0';

        if ((cache = g_malloc(messageLength + 1))) {
            memcpy(cache, buffer, messageLength);
            cache[messageLength] = '\0';
            (*tocH)->sums[sumNum].cache = (void *)cache;
        }
    }

    if ((*tocH)->sums[sumNum].uidHash == kNeverHashed)
        Rehash(tocH, sumNum, buffer);

    if (!((*(*messH)->tocH)->sums[(*messH)->sumNum].flags & FLAG_SHOW_ALL)) {
        WeedHeaders(buffer, &weeded, BadHeadStrn, &weeds);
        (*messH)->weeded = weeded;
        StripTrailingNewlines(buffer, 
                              (*(*messH)->tocH)->sums[(*messH)->sumNum].bodyOffset - weeded + 1);
    } else
        (*messH)->weeded = 0;
    WeedHeaders(buffer, &weeded, FROM_STRN, NULL);
    (*messH)->weeded += weeded;
    // AccuTrim(&weeds); // Implement if needed
    (*messH)->extras = weeds;

    tableId = (*tocH)->sums[sumNum].tableId;
    if (tableId == DEFAULT_TABLE)
        tableId = GetPrefLong(PREF_IN_XLATE);
    if (tableId != NO_TABLE) {
        // Handle character translation if needed
        // This would need to be implemented based on requirements
    }

    return (buffer);

failure:
    if (buffer)
        g_free(buffer);
    return (NULL);
}

/**********************************************************************
 * ReadMessage - read a given message into a preallocated buffer
 **********************************************************************/
int ReadMessage(TOCHandle tocH, int sumN, char *buffer) {
    long count;
    char name[64];
    short sumNum;

    tocH = GetRealTOC(tocH, sumN, &sumNum);
    if (!tocH)
        return fnfErr;
    GetMailboxName(tocH, sumNum, name);
    count = (*tocH)->sums[sumNum].length;

    if (!(MessErr = BoxFOpenLo(tocH, sumNum)))
        if ((MessErr = SetFPos((*tocH)->refN, fsFromStart,
                               (*tocH)->sums[sumNum].offset)) ||
            (MessErr = ARead((*tocH)->refN, &count, buffer)))
            FileSystemError(READ_MBOX, name, MessErr);

    return (MessErr);
}

/**********************************************************************
 * MessageError - return the most recent error code from these functions
 **********************************************************************/
int MessageError(void) { 
    return (MessErr); 
}

/**********************************************************************
 * StripTrailingNewlines - strip the newlines off the end of a text block
 **********************************************************************/
long StripTrailingNewlines(char *buffer, long stop) {
    long size = strlen(buffer);
    char *spot = buffer + size;
    long newSize;

    while (spot > buffer + stop && spot[-1] == '\015')
        spot--;
    newSize = spot - buffer;
    buffer[newSize] = '\0';
    return (size - newSize);
}

