/* gEditCtrl compatibility functions */
int PeteCopyNoLabel(GtkWidget *fromPte, GtkWidget *toPte, long start, long end, long insertPos, void *p, bool b, int flags) {
    geditDocument *fromDoc = geditctrl_get_document(fromPte);
    geditDocument *toDoc = geditctrl_get_document(toPte);
    
    gchar *text = gedit_document_get_text(fromDoc);
    if (text && start < strlen(text)) {
        long copyLen = (end > strlen(text)) ? strlen(text) - start : end - start;
        if (copyLen > 0) {
            gchar *copyText = g_strndup(text + start, copyLen);
            gedit_document_insert_text(toDoc, insertPos, copyText);
            g_free(copyText);
        }
    }
    g_free(text);
    return 0;
}

char *HeaderName(int head) {
    static char *headers[] = {"", "From", "To", "Cc", "Bcc", "Subject", "Attachments"};
    if (head >= 0 && head < 7) return headers[head];
    return "";
}

